# Read by docker-compose.yml (Compose auto-loads a .env file next to
# it) — separate from backend/.env, which the Go API itself reads via
# godotenv. Copy this to .env and change the values; never commit the
# real .env (see .gitignore).

POSTGRES_PASSWORD=postgres
REDIS_PASSWORD=dev-only-redis-password-change-me

# Generate real values with: openssl rand -base64 48
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-1234567890
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me-1234567890
