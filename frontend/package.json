    "@mui/material": "^9.4.0",
    "@mui/x-date-pickers": "^9.13.0",
    "@tanstack/react-query": "^5.28.0",
    "dayjs": "^1.11.23",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
