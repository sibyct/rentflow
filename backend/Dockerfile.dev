# Local development image: runs the API with hot reload via air.
FROM golang:1.25-alpine
WORKDIR /app

RUN apk add --no-cache git
# air's own go.mod may require a newer Go than this base image ships —
# GOTOOLCHAIN=auto scoped to just this command lets it fetch whatever
# it needs to build itself, without affecting the toolchain used to
# build the actual app below (which the base image's Go already satisfies).
RUN GOTOOLCHAIN=auto go install github.com/air-verse/air@latest

COPY go.mod go.sum ./
RUN go mod download

COPY . .

EXPOSE 8080
CMD ["air", "-c", ".air.toml"]
