# Copy this file to .env for local development (docker-compose reads it
# automatically). Never commit a real .env file.

APP_ENV=development
HTTP_PORT=8080

DATABASE_URL=postgres://postgres:postgres@localhost:5432/propertymanagement?sslmode=disable
DATABASE_MAX_CONNS=10

REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# Generate real values with: openssl rand -base64 48
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-1234567890
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me-1234567890
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# Leave empty for localhost; set to your real domain in production.
COOKIE_DOMAIN=
COOKIE_SECURE=false

ALLOWED_ORIGINS=http://localhost:5173
