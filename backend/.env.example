# Copy this file to .env for running the API natively (`make run`),
# read directly by the Go binary via godotenv — NOT read by
# docker-compose, which has its own .env at the repo root instead (see
# ../.env.example). Never commit a real .env file.

APP_ENV=development
HTTP_PORT=8080

DATABASE_URL=postgres://postgres:postgres@localhost:5432/propertymanagement?sslmode=disable
DATABASE_MAX_CONNS=10

# Must match REDIS_PASSWORD in ../.env — docker-compose.yml starts
# Redis with --requirepass, so an empty password here would fail to
# authenticate against Compose's Redis (NOAUTH), silently degrading
# caching and refresh-token revocation rather than erroring loudly
# (see cmd/api/main.go's redis connection handling).
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=dev-only-redis-password-change-me
REDIS_DB=0

# Generate real values with: openssl rand -base64 48
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-1234567890
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me-1234567890
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# Leave empty for localhost; set to your real domain in production.
COOKIE_DOMAIN=
COOKIE_SECURE=false

ALLOWED_ORIGINS=http://localhost:5173
