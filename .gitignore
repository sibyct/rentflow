# Environment files — never commit real .env files, anywhere in the repo.
# .env.example files are the exception: they hold placeholder values only
# and are meant to be committed as templates.
.env
.env.*
!.env.example
!**/.env.example

# Backend (Go)
backend/bin/
backend/tmp/
*.test

# Frontend (Node)
frontend/node_modules/
frontend/dist/
frontend/coverage/
frontend/*.tsbuildinfo

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
